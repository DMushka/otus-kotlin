{
  "request": {
    "method": "POST",
    "url": "/ci/basic/update"
  },

  "response": {
    "status": 200,
    "jsonBody": {
      "responseType": "update",
      "result": "success",
      "cib": {
        "id": "{{{jsonPath request.body '$.cib.id'}}}",
        "title": "{{{jsonPath request.body '$.cib.title'}}}",
        "description": "{{{jsonPath request.body '$.cib.description'}}}",
        "country": "Australia",
        "currency": "RUB",
        "nominal": "1",
        "material": "медь",
        "diameter": 1.0,
        "startYear": "2019",
        "stopYear": "2019",
        "lock": "125"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  }
}
