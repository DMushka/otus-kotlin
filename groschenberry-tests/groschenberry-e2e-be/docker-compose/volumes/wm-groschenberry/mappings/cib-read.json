{
  "request": {
    "method": "POST",
    "url": "/ci/basic/read"
  },

  "response": {
    "status": 200,
    "jsonBody": {
      "responseType": "read",
      "result": "success",
      "cib": {
        "id": "{{{jsonPath request.body '$.cib.id'}}}",
        "title": "cib title",
        "description": "cib description",
        "country": "Australia",
        "currency": "RUB",
        "nominal": "1",
        "material": "медь",
        "diameter": 1.0,
        "startYear": "2019",
        "stopYear": "2019"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  }
}
